# ─────────────────────────────────────────────────────────────
# Template konfigurasi. SALIN file ini jadi ".env" lalu isi nilainya.
#   cp .env.example .env
#
# PENTING: file .env berisi rahasia — JANGAN di-commit ke Git!
# (sudah masuk .gitignore)
# ─────────────────────────────────────────────────────────────

# API key yang boleh mengakses API ini (pisahkan dengan koma untuk banyak key)
API_KEYS=

# Kredensial DeepSeek (untuk generation jawaban).
# Daftar & buat key di: https://platform.deepseek.com
# Kalau dikosongkan, API tetap jalan dalam mode "retrieval-only".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Model embedding (gratis, jalan lokal). Multilingual = paham Bahasa Indonesia.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Batas request per pengguna (format slowapi)
RATE_LIMIT=10/minute
